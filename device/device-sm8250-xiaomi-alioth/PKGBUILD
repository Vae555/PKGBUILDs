package() {
    install -Dm644 "$srcdir/wifi-powersave.conf" "$pkgdir/etc/NetworkManager/conf.d/wifi-powersave.conf"
    install -Dm644 "$srcdir"/81-libssc-xiaomi-alioth.rules -t "$pkgdir"/usr/lib/udev/rules.d/
    install -Dm644 "$srcdir"/hexagonrpcd.confd "$pkgdir"/etc/conf.d/hexagonrpcd-sdsp
    install -Dm644 "$srcdir/HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/HiFi.conf"
    install -Dm644 "$srcdir/alioth.conf" "$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/alioth.conf"
    mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
    ln -s ../../Xiaomi/alioth/alioth.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/xiaomi-alioth.conf"
    install -Dm644 "$srcdir"/51-qcom.conf "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/51-qcom.conf
    install -Dm644 "$srcdir"/hexagonrpcd.lst "$pkgdir"/etc/kupfer/systemd/hexagonrpcd.lst
    install -Dm644 "$srcdir"/bootmac-bt.lst "$pkgdir"/etc/kupfer/systemd/bootmac-bt.lst
    install -Dm644 "$srcdir"/sm8250.lst "$pkgdir"/etc/kupfer/systemd/sm8250.lst
    install -Dm644 "$srcdir"/plasmalogin.lst "$pkgdir"/etc/kupfer/systemd/plasmalogin.lst
    mkdir -p "$pkgdir"/etc/systemd/system
    ln -sf /usr/lib/systemd/system/graphical.target "$pkgdir"/etc/systemd/system/default.target
    install -Dm644 "$srcdir"/rootston.ini "$pkgdir"/etc/phosh/rootston.ini
    install -Dm644 "$srcdir"/autologin.conf "$pkgdir"/etc/plasmalogin.conf.d/autologin.conf
    install -Dm644 "$srcdir"/xiaomi-alioth.conf "$pkgdir"/etc/kupfer/mkinitcpio.conf.d/xiaomi-alioth.conf
    install -Dm644 "$srcdir"/machine-info "$pkgdir"/etc/machine-info

    cp "$srcdir"/deviceinfo "$srcdir"/deviceinfo_
    sed -i 's/deviceinfo_kernel_cmdline=""/deviceinfo_kernel_cmdline="net.ifnames=0"/' "$srcdir/deviceinfo_"
    cat >>"$srcdir"/deviceinfo_ <<EOF

deviceinfo_partitions_data="/dev/sda35"
deviceinfo_modules_initfs="$(cat "$srcdir"/modules-initfs | tr '\n' ' ')"
EOF
    install -Dm644 "$srcdir"/deviceinfo_ "$pkgdir"/etc/kupfer/deviceinfo
}
