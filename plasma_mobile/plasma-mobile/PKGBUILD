# Contributor: Devin Lin <devin@kde.org>
_mode=host
_crossdirect=false
pkgname=plasma-mobile
pkgdesc="Plasma Mobile shell components."
pkgver=6.6.2.r0.g827ea90
pkgrel=1
_arches=all
arch=(
    aarch64
    x86_64
    armv7h
)
license=(GPL-2.0-or-later)
depends=(
    plasma-nano
    plasma-nm
    plasma-pa
    bluez-qt
    powerdevil
    modemmanager-qt
    qqc2-breeze-style
    kirigami-addons
    plasma-keyboard
    kpipewire
    plasma-settings
    kwin
    qt6-sensors
)
optdepends=(
    "plasma-settings: Settings application for Plasma Mobile"
    "plasma-dialer: Phone application"
    "plasma-workspace-wallpapers: A large wallpaper selection for Plasma"
)
makedepends=(
    cmake
    extra-cmake-modules
)
_commit=827ea900231fdb58fcf3b742bb353beaf67c5bb5
source=(
    "git+https://invent.kde.org/plasma/plasma-mobile.git#commit=$_commit"
)
sha256sums=(
    SKIP
)

pkgver() {
    cd "$pkgname"
    git describe --long --abbrev=7 --tags "$_commit" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    cmake -B build -S "${pkgname}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=/usr/lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DINSTALL_SYSTEMD_SERVICE=ON \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
